<h2>Mark Attendance</h2>
<form method="post" class="row g-3">
    <div class="col-md-4"><label class="form-label">Check In</label><input name="checkInTime" type="time" class="form-control" value="08:45" /></div>
    <div class="col-md-4"><label class="form-label">Check Out</label><input name="checkOutTime" type="time" class="form-control" value="17:30" /></div>
    <div class="col-12"><button class="btn btn-primary">Submit</button></div>
</form>
