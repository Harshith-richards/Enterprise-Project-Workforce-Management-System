@model IEnumerable<Attendance>
<h2>My Attendance</h2>
<table class="table table-striped"><thead><tr><th>Date</th><th>Check In</th><th>Check Out</th><th>Status</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Date.ToShortDateString()</td><td>@item.CheckInTime</td><td>@item.CheckOutTime</td><td>@item.Status</td></tr>
}
</tbody></table>
