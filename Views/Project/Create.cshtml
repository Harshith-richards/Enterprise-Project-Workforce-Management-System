@model ProjectFormViewModel
<h2>Create Project</h2>
<form method="post" class="row g-3">
    <div class="col-md-6"><label asp-for="ProjectName" class="form-label"></label><input asp-for="ProjectName" class="form-control"/></div>
    <div class="col-md-6"><label asp-for="ClientName" class="form-label"></label><input asp-for="ClientName" class="form-control"/></div>
    <div class="col-md-4"><label asp-for="ProjectType" class="form-label"></label><select asp-for="ProjectType" asp-items="Html.GetEnumSelectList<ProjectType>()" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="Budget" class="form-label"></label><input asp-for="Budget" class="form-control"/></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" type="date"/></div>
    <div class="col-md-4"><label asp-for="Deadline" class="form-label"></label><input asp-for="Deadline" class="form-control" type="date"/></div>
    <div class="col-md-4"><label asp-for="ManagerId" class="form-label">Manager</label><select asp-for="ManagerId" asp-items="Model.Managers" class="form-select"></select></div>
    <div class="col-12"><label asp-for="EngineerIds" class="form-label">Engineers</label><select asp-for="EngineerIds" asp-items="Model.Engineers" class="form-select" multiple></select></div>
    <div class="col-12"><button class="btn btn-primary">Save Project</button></div>
</form>
