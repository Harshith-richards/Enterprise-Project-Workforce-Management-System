@model IEnumerable<Project>
@{ ViewData["Title"] = "Projects"; }
<div class="d-flex justify-content-between mb-3">
    <h2>Projects</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <a asp-action="Create" class="btn btn-primary">New Project</a>
    }
</div>
<table class="table table-bordered table-striped">
    <thead><tr><th>Name</th><th>Client</th><th>Type</th><th>Manager</th><th>Deadline</th><th>Status</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProjectName</td><td>@p.ClientName</td><td>@p.ProjectType</td><td>@p.Manager?.FullName</td><td>@p.Deadline.ToShortDateString()</td><td><span class="badge bg-secondary">@p.Status</span></td>
        </tr>
    }
    </tbody>
</table>
